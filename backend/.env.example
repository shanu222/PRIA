# PRIA API (Railway). Copy to backend/.env for local development.

NODE_ENV=development
# Railway injects PORT automatically; only needed locally.
PORT=4000

# Bearer token for write endpoints (PUT /api/...). At least 24 characters.
# Generate with: openssl rand -hex 32
ADMIN_API_KEY=

# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:3000

# "file" for local development, "r2" for Railway (Railway's disk is wiped on redeploy).
STORAGE_DRIVER=file
DATA_FILE=./data/pria-content.json
# Seconds the API caches the content document in memory.
CACHE_TTL_SECONDS=30
# Media (DRIM photos, boards, PDFs, logo) served at GET /assets/{key}. With STORAGE_DRIVER=r2 the
# keys are read from the bucket (drim/..., brand/...); with "file" they are read from this folder.
# Upload a folder to R2 with: npx tsx scripts/upload-assets.ts <folder>
ASSETS_DIR=./data/assets

# Cloudflare R2 (required when STORAGE_DRIVER=r2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=pria-content
R2_OBJECT_KEY=content/pria-content.json

# Portal revalidation: called after every successful write so Vercel refreshes pages.
# e.g. https://your-project.vercel.app/api/revalidate
FRONTEND_REVALIDATE_URL=
# Must match REVALIDATE_SECRET on Vercel.
REVALIDATE_SECRET=
