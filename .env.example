# Frontend (Vercel). Copy to .env.local for local development.

# Base URL of the PRIA API on Railway, without a trailing slash.
# Leave empty to run the portal on the local content in src/data/pria.ts only.
PRIA_API_URL=http://localhost:4000

# Shared secret the API sends when content changes (POST /api/revalidate).
# Must match REVALIDATE_SECRET on Railway. Generate with: openssl rand -hex 32
REVALIDATE_SECRET=change-me

# How often (seconds) pages re-check the API even without a revalidation call.
CONTENT_REVALIDATE_SECONDS=300
